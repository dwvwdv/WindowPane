# Copy to .env and adjust. Never commit a real .env.
WORLDPANE_ENV=dev
# HMAC key for pairing-code hashes. REQUIRED outside dev (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
WORLDPANE_PAIRING_CODE_SECRET=
WORLDPANE_PAIRING_CODE_TTL_SECONDS=600
WORLDPANE_PAIRING_CODE_MAX_USES=1
WORLDPANE_SEED_DEMO_WORLD=true
# Optional fixed 6-digit code for the seeded demo world (dev only); random if empty.
WORLDPANE_DEMO_PAIRING_CODE=
# memory | postgres
WORLDPANE_REPOSITORY=memory
# Service-role DSN for the worldpane schema (Supabase pooler works). Never commit a value.
WORLDPANE_DATABASE_URL=
WORLDPANE_SIMULATION_PROVIDER=core
# Dashboard sign-in with Supabase Auth (Project URL + anon key); accounts must be in worldpane.admins.
WORLDPANE_SUPABASE_URL=
WORLDPANE_SUPABASE_ANON_KEY=
# Optional shared admin token (>= 16 chars) for scripts / CI. No sign-in method = admin API disabled.
WORLDPANE_ADMIN_TOKEN=
