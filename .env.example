# Settings for `docker compose up`. Copy to .env and adjust; never commit a real .env.

# Supabase: the service-role Postgres connection string (Project Settings → Database;
# the pooler works). Required unless you start the bundled DB with --profile local-db.
WORLDPANE_DATABASE_URL=

# Host port for the API.
WORLDPANE_PORT=8000

# Only for --profile local-db: bundled Postgres passwords. Change them before the first start
# (they are set when the database volume is created).
POSTGRES_PASSWORD=worldpane
WORLDPANE_DB_PASSWORD=worldpane

# Dashboard sign-in with Supabase Auth: Project URL and anon (publishable) key of the shared
# project (public values, the same ones the Lazyrhythm site ships). Accounts also need a row in
# worldpane.admins (see worldpane-server/README.md).
WORLDPANE_SUPABASE_URL=https://pwrwclutauqxbqsqfkjj.supabase.co
WORLDPANE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3cndjbHV0YXVxeGJxc3Fma2pqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzQxNjk2OTEsImV4cCI6MjA0OTc0NTY5MX0.vuocg4yRU0Tvx1ylxN9AXRwwifKWDAuyCjaE7wb_KRg

# Optional shared admin token (>= 16 chars) for scripts / CI, or a dashboard without Supabase.
# e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WORLDPANE_ADMIN_TOKEN=

# Prebuilt image from GitHub Actions instead of building locally (then: docker compose pull).
# WORLDPANE_IMAGE=ghcr.io/dwvwdv/worldpane-server:latest

# HMAC key for pairing codes. Leave empty to generate one on first start (kept in a volume).
WORLDPANE_PAIRING_CODE_SECRET=

WORLDPANE_DEFAULT_TIMEZONE=Asia/Taipei
WORLDPANE_PAIRING_CODE_TTL_SECONDS=600
WORLDPANE_PAIRING_CODE_MAX_USES=1

# Demo world (小白 + 小雞毛). The pairing code is only logged when WORLDPANE_ENV=dev.
WORLDPANE_ENV=prod
WORLDPANE_SEED_DEMO_WORLD=false
WORLDPANE_DEMO_PAIRING_CODE=
